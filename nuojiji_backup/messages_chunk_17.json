terId":"d0427ad4-65d8-4dca-8944-1a86643bc08d","_id":989},{"id":1779430653697,"text":"这种吗","sender":"me","time":"14:41","timestamp":1779432114414,"replyTo":null,"userId":"uid_1777031442059_13a5e15u7","characterId":"d0427ad4-65d8-4dca-8944-1a86643bc08d","_id":990},{"id":1779430653698,"text":"(⁠・⁠_⁠・⁠;⁠)","sender":"me","time":"14:42","timestamp":1779432122075,"userId":"uid_1777031442059_13a5e15u7","characterId":"d0427ad4-65d8-4dca-8944-1a86643bc08d","_id":991},{"id":1779430653699,"sender":"them","text":"A bouquet of cash thrown at my face?","timestamp":1779432160125,"tempo":"N","translation":"把一束钞票甩我脸上？","hasThinking":true,"rawContent":"A bouquet of cash thrown at my face? || 把一束钞票甩我脸上？","roundId":"round_1779432123055_q9u8us3ws","userId":"uid_1777031442059_13a5e15u7","characterId":"d0427ad4-65d8-4dca-8944-1a86643bc08d","_id":992},{"id":1779430653700,"sender":"them","text":"I'd like to see you try. You probably couldn't even reach my face without a stepping stool.","timestamp":1779432160830,"tempo":"N","translation":"我倒想看你试试。你没个垫脚的凳子估计都够不着我的脸。","rawContent":"I'd like to see you try. You probably couldn't even reach my face without a stepping stool. || 我倒想看你试试。你没个垫脚的凳子估计都够不着我的脸。","roundId":"round_1779432123055_q9u8us3ws","userId":"uid_1777031442059_13a5e15u7","characterId":"d0427ad4-65d8-4dca-8944-1a86643bc08d","_id":993},{"id":1779430653701,"sender":"them","text":"[語音消息]","timestamp":1779432161532,"tempo":"N","isVoice":true,"voice":true,"voiceText":"But if you're actually asking if I'm alone tonight... the answer is yes.","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"amused","translation":"不过你要是真的在问我今晚是不是一个人……答案是肯定的。","rawContent":"[語音消息] || 不过你要是真的在问我今晚是不是一个人……答案是肯定的。","roundId":"round_1779432123055_q9u8us3ws","userId":"uid_1777031442059_13a5e15u7","characterId":"d0427ad4-65d8-4dca-8944-1a86643bc08d","_id":994},{"id":1779430653702,"sender":"them","text":"You can keep the cash, though. Just bring yourself.","timestamp":1779432162233,"tempo":"S","translatio